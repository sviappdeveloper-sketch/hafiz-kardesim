<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:gravity="center_vertical"
    android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/pw_city" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="13sp" android:textStyle="bold" android:textColor="#F2C14A"
            android:maxLines="1" android:ellipsize="end" android:text="Hatim Kardeşim" />
        <TextView android:id="@+id/pw_nexttxt" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#FBF3DF" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/pw_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center" android:textSize="13sp" android:textColor="#95B5A2"
        android:visibility="gone" />
    <LinearLayout android:id="@+id/pw_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/pw0" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical"
            android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_cell">
            <TextView android:id="@+id/pn0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textStyle="bold" android:textColor="#95B5A2" android:maxLines="1" />
            <TextView android:id="@+id/pt0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:textColor="#FBF3DF" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pw1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical"
            android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_cell">
            <TextView android:id="@+id/pn1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textStyle="bold" android:textColor="#95B5A2" android:maxLines="1" />
            <TextView android:id="@+id/pt1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:textColor="#FBF3DF" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pw2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical"
            android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_cell">
            <TextView android:id="@+id/pn2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textStyle="bold" android:textColor="#95B5A2" android:maxLines="1" />
            <TextView android:id="@+id/pt2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:textColor="#FBF3DF" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pw3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical"
            android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_cell">
            <TextView android:id="@+id/pn3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textStyle="bold" android:textColor="#95B5A2" android:maxLines="1" />
            <TextView android:id="@+id/pt3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:textColor="#FBF3DF" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pw4" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical"
            android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_cell">
            <TextView android:id="@+id/pn4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textStyle="bold" android:textColor="#95B5A2" android:maxLines="1" />
            <TextView android:id="@+id/pt4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:textColor="#FBF3DF" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pw5" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="0dp" android:orientation="vertical"
            android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_cell">
            <TextView android:id="@+id/pn5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textStyle="bold" android:textColor="#95B5A2" android:maxLines="1" />
            <TextView android:id="@+id/pt5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:textColor="#FBF3DF" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
